<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MiniInventario.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MiniInventario"
    FlyoutBehavior="Flyout">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#2196F3" HeightRequest="150" Padding="20" VerticalOptions="Fill">
            <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                <Label Text="🧽" FontSize="36" HorizontalOptions="Start" />
                <Label Text="EcoClean" 
                       TextColor="White" 
                       FontSize="20" 
                       FontAttributes="Bold" />
                <Label Text="Administracion del negocio" 
                       TextColor="#E0E0E0" 
                       FontSize="14" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>
    
    <FlyoutItem Title="Inventario">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="📦" Size="24" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Métricas">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="📊" Size="24" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate local:MetricasPage}" Route="MetricasPage" />
    </FlyoutItem>
    
    <FlyoutItem Title="Ventas">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="🛒" Size="24" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate local:VentasPage}" Route="VentasPage" />
    </FlyoutItem>
    
    <FlyoutItem Title="Ganancias">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="💰" Size="24" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate local:GananciasPage}" Route="GananciasPage" />
    </FlyoutItem>
    
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20" Spacing="10">
            <BoxView HeightRequest="1" Color="#E0E0E0" />
            <Label Text="Versión 1.0.0" 
                   TextColor="Gray" 
                   FontSize="12" 
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
    <Shell.FlyoutIcon>
        <FontImageSource Glyph="☰" Size="24"
                         Color= "White" />
    </Shell.FlyoutIcon>
</Shell>