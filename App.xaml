<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MiniInventario"
             x:Class="MiniInventario.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="Acento">#6C5CE7</Color>

            <!-- Etiqueta pequeña sobre cada campo -->
            <Style x:Key="EtiquetaCampo" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#A0A0A0}" />
                <Setter Property="Margin" Value="2,0,0,4" />
            </Style>

            <!-- Contenedor redondeado para cada Entry -->
            <Style x:Key="CampoBorde" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E1E4EE, Dark=#3A3A3A}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAFAFC, Dark=#262626}" />
                <Setter Property="Padding" Value="14,0" />
            </Style>

            <Style x:Key="CampoEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
